# Copy to site/publish.env (gitignored). The environment overrides this file.
DG_HOST=deploy@example.org            # ssh target, key auth, non-interactive
DG_DEST=/var/www/dataguard            # the directory nginx serves; replaced atomically
DG_OWNER=www-data:www-data            # chown after unpack; empty = leave as unpacked
DG_URL=https://dataguard.davidbudac.cz/   # verified after the upload
