{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dataguard-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5179",
        "--strictPort"
      ],
      "cwd": "app",
      "port": 5179
    },
    {
      "name": "dataguard-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8741",
        "--directory",
        "_site"
      ],
      "port": 8741
    },
    {
      "name": "dataguard-repo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8743",
        "--directory",
        "."
      ],
      "port": 8743
    },
    {
      "name": "dataguard-site-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8742",
        "--directory",
        "_site"
      ],
      "port": 8742
    },
    {
      "name": "dataguard-proto",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5182",
        "--strictPort"
      ],
      "cwd": ".claude/worktrees/playground/app",
      "port": 5182
